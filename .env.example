# CHIMBO environment settings
# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=CHIMBO
APP_ENV=local                          # local | staging | production
APP_DEBUG=true                         # true shows error details (local only!)
APP_URL=http://localhost/chimbo        # no trailing slash
APP_TRUSTED_HOSTS=                      # extra hosts allowed in links, comma-separated (e.g. staging.example.com); APP_URL's host is always allowed
APP_TRUSTED_PROXIES=127.0.0.1,::1        # local ngrok proxy; on hosting replace with the proxy IPs/CIDRs
APP_TIMEZONE=Africa/Dar_es_Salaam      # used for display; the database stores UTC

# --- Security ---
APP_KEY=                               # 64 random hex characters; generate with: php -r "echo bin2hex(random_bytes(32));"

# --- First admin (used once by: php database/migrate.php --seed) ---
SEED_ADMIN_EMAIL=admin@chimbo.test
SEED_ADMIN_NAME="CHIMBO Admin"

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chimbo
DB_USERNAME=root
DB_PASSWORD=

# --- Login codes (OTP) ---
# true = the login code is returned to the app instead of needing an SMS ("show code" mode).
# For your computer and a staging/beta server with TEST data only. Always ignored when APP_ENV=production.
OTP_SHOW_CODE=true

# --- SMS (OTP) ---
SMS_DRIVER=log                         # log = write OTPs to storage/logs (development)

# --- Payments ---
PAYMENT_DRIVER=sandbox                 # sandbox = fake provider for development

# --- Mobile push notifications (Firebase Cloud Messaging) ---
# Absolute path to the Firebase service-account JSON on the backend server.
# Keep this file outside the public web root and never put it in the Flutter app.
FCM_SERVICE_ACCOUNT_FILE=

# --- Visual Search (Gemini Flash API) ---
# Optional: Used by mobile/web camera search to recognize products in photos.
# Free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
