# Send every request under /api/ to api/index.php (the API front controller)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Make sure PHP receives the "Authorization: Bearer ..." header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
